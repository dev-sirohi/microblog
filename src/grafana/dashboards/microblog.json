{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "title": "Microblog API",
  "uid": "microblog-api",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "10s",
  "templating": { "list": [] },
  "panels": [
    {
      "type": "timeseries",
      "title": "Request latency (p50 / p95 / p99)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p99" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Request rate by status code",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(rate(http_requests_received_total[5m])) by (code)", "legendFormat": "{{code}}" }
      ]
    },
    {
      "type": "stat",
      "title": "Cache hit ratio",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null },
            { "color": "yellow", "value": 0.5 },
            { "color": "green", "value": 0.8 }
          ] }
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "sum(rate(microblog_cache_hits_total[5m])) / clamp_min(sum(rate(microblog_cache_hits_total[5m])) + sum(rate(microblog_cache_misses_total[5m])), 1)" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Cache hits vs misses",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(rate(microblog_cache_hits_total[5m]))", "legendFormat": "hits" },
        { "refId": "B", "expr": "sum(rate(microblog_cache_misses_total[5m]))", "legendFormat": "misses" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Background sync queue depth",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "microblog_background_sync_queue_depth", "legendFormat": "queued events" },
        { "refId": "B", "expr": "sum(rate(microblog_background_sync_processed_total[5m]))", "legendFormat": "processed/s" }
      ]
    }
  ]
}
