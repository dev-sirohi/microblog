# Copy this file to ".env" and adjust as needed.

# REQUIRED — where your running API lives. This is the only line you must set.
BASE_URL=http://localhost:5182

# How hard to push: smoke | ramp | spike | soak | stress
LOAD_PROFILE=ramp

# How long the load runs, in seconds.
DURATION_SECONDS=60

# How many fake logged-in users each scenario creates before it starts.
SEED_USERS=50
