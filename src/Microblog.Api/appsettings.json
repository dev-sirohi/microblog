    "BlobContainerName": "microblog-media",
    "ServiceBusConnectionString": "",
    "ServiceBusQueueName": "microblog-events"
  },
  "Observability": {
    "OtlpEndpoint": "http://localhost:4317",
    "ServiceName": "microblog-api"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
