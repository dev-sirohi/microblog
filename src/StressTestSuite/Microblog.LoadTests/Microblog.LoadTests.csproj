<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NBomber" Version="6.4.1" />
    <PackageReference Include="NBomber.Http" Version="6.2.0" />
  </ItemGroup>

  <!-- Copy the .env file next to the built app so it's found no matter how you run. -->
  <ItemGroup>
    <None Include=".env" Condition="Exists('.env')" CopyToOutputDirectory="PreserveNewest" />
    <None Include=".env.example" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
